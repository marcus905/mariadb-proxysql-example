datadir="/var/lib/proxysql"
errorlog="/var/lib/proxysql/proxysql.log"

admin_variables=
{
    admin_credentials="admin:admin;radmin:radminpass"
    mysql_ifaces="0.0.0.0:6032"
}

mysql_variables=
{
    threads=4
    max_connections=1024
    interfaces="0.0.0.0:6033"
    monitor_username="monitor"
    monitor_password="monitorpass"
    monitor_connect_interval=2000
    monitor_ping_interval=2000
    monitor_galera_healthcheck_interval=2000
}

mysql_servers =
(
    { address="galera1", port=3306, hostgroup=10, max_connections=200 },
    { address="galera2", port=3306, hostgroup=10, max_connections=200 },
    { address="galera3", port=3306, hostgroup=10, max_connections=200 }
)

mysql_users =
(
    { username="labuser", password="labpass", default_hostgroup=10, active=1, max_connections=200 }
)

